{
  "_comment": "WORKED EXAMPLE 3 of 3 — heavy expert modification. Forks the dice-pool lineage and then departs from it substantially: a variable success threshold driven by a corruption track, two custom rules built from triggers and effects, a two-sided meta-currency, and an authored subsystem. This is the stress test for 'complex modifications' — everything unusual here is expressed in typed primitives with no scripting.",

  "schemaVersion": 1,
  "lineage": ["scratch", "pool-family", "pool-d10"],

  "meta": {
    "id": "gilt-and-ash",
    "name": "Gilt and Ash",
    "pitch": "Court sorcerers bargain away pieces of themselves for power. The more you have taken, the easier magic comes and the harder everything else gets.",
    "toneTags": ["gritty", "mythic", "bleak"],
    "playPattern": "gm-party",
    "partySize": { "min": 3, "max": 5 },
    "sessionShape": "campaign",
    "dials": {
      "crunch": 7,
      "lethality": 6,
      "swinginess": 5,
      "playerAuthority": 6,
      "prepBurden": 5,
      "powerCeiling": 6
    }
  },

  "resolution": {
    "dice": {
      "kind": "pool-count",
      "count": { "t": "bin", "op": "+",
        "a": { "t": "ref", "path": "attr.selected.value" },
        "b": { "t": "ref", "path": "skill.selected.value" } },
      "sides": 10,
      "successOn": 8,
      "botchOn": 1,
      "companionDice": []
    },
    "direction": "high",
    "comparison": { "mode": "count-vs", "required": { "t": "ref", "path": "difficulty.value" } },
    "bands": [
      {
        "id": "botch",
        "label": "Backlash",
        "when": {
          "t": "bin", "op": "&&",
          "a": { "t": "bin", "op": "==", "a": { "t": "ref", "path": "successes" }, "b": { "t": "num", "v": 0 } },
          "b": { "t": "bin", "op": ">=", "a": { "t": "ref", "path": "botches" }, "b": { "t": "num", "v": 2 } }
        },
        "valence": "critical-failure",
        "guidance": "The bargain notices. Advance the Debt clock one segment and describe what it costs.",
        "effects": [
          { "kind": "start-clock", "clockId": "debt", "segments": { "t": "num", "v": 1 } },
          { "kind": "adjust-harm", "trackId": "corruption", "amount": { "t": "num", "v": 1 } }
        ]
      },
      {
        "id": "failure",
        "label": "Failure",
        "when": {
          "t": "bin", "op": "&&",
          "a": { "t": "bin", "op": "<", "a": { "t": "ref", "path": "successes" }, "b": { "t": "ref", "path": "target" } },
          "b": { "t": "un", "op": "!",
            "a": { "t": "bin", "op": "&&",
              "a": { "t": "bin", "op": "==", "a": { "t": "ref", "path": "successes" }, "b": { "t": "num", "v": 0 } },
              "b": { "t": "bin", "op": ">=", "a": { "t": "ref", "path": "botches" }, "b": { "t": "num", "v": 2 } } } }
        },
        "valence": "failure",
        "guidance": "Not enough. The attempt fails; the GM says what changes.",
        "effects": []
      },
      {
        "id": "success",
        "label": "Success",
        "when": {
          "t": "bin", "op": "&&",
          "a": { "t": "bin", "op": ">=", "a": { "t": "ref", "path": "successes" }, "b": { "t": "ref", "path": "target" } },
          "b": { "t": "bin", "op": "<",
            "a": { "t": "ref", "path": "successes" },
            "b": { "t": "bin", "op": "+", "a": { "t": "ref", "path": "target" }, "b": { "t": "num", "v": 3 } } }
        },
        "valence": "success",
        "guidance": "It works. Each success past the requirement is a point of Effect to spend.",
        "effects": []
      },
      {
        "id": "triumph",
        "label": "Triumph",
        "when": {
          "t": "bin", "op": ">=",
          "a": { "t": "ref", "path": "successes" },
          "b": { "t": "bin", "op": "+", "a": { "t": "ref", "path": "target" }, "b": { "t": "num", "v": 3 } }
        },
        "valence": "critical-success",
        "guidance": "Overwhelming. Spend Effect freely and take back one point of Corruption.",
        "effects": [
          { "kind": "adjust-harm", "trackId": "corruption", "amount": { "t": "num", "v": -1 } }
        ]
      }
    ],
    "contributions": [
      { "source": "attribute", "apply": "pool-size" },
      { "source": "skill", "apply": "pool-size" },
      { "source": "equipment", "apply": "extra-die" },
      { "source": "situational", "apply": "extra-dice" }
    ],
    "swingModifiers": ["extra-dice", "reroll"],
    "secondaryAxis": {
      "id": "effect",
      "label": "Effect",
      "source": "margin-derived",
      "paysCurrency": "leverage",
      "bands": [
        { "id": "limited", "label": "Limited",
          "when": { "t": "bin", "op": "<=", "a": { "t": "ref", "path": "margin" }, "b": { "t": "num", "v": 0 } },
          "valence": "mixed", "guidance": "It happens, barely.", "effects": [] },
        { "id": "standard-effect", "label": "Standard",
          "when": { "t": "bin", "op": "==", "a": { "t": "ref", "path": "margin" }, "b": { "t": "num", "v": 1 } },
          "valence": "success", "guidance": "It happens as described.", "effects": [] },
        { "id": "great", "label": "Great",
          "when": { "t": "bin", "op": ">=", "a": { "t": "ref", "path": "margin" }, "b": { "t": "num", "v": 2 } },
          "valence": "critical-success", "guidance": "It happens, and more.", "effects": [] }
      ]
    },
    "interventions": [
      {
        "id": "call-the-debt",
        "label": "Call the Debt",
        "currency": "leverage",
        "cost": { "t": "num", "v": 1 },
        "effect": "add-die",
        "magnitude": { "t": "num", "v": 3 }
      },
      {
        "id": "declare-obligation",
        "label": "Declare an Obligation",
        "currency": "leverage",
        "cost": { "t": "num", "v": 2 },
        "effect": "declare-detail"
      }
    ]
  },

  "difficulty": {
    "anchorSuccessRate": 0.66,
    "ladder": [
      { "id": "routine", "label": "Routine", "value": 1, "isStandard": true },
      { "id": "demanding", "label": "Demanding", "value": 2, "isStandard": false },
      { "id": "punishing", "label": "Punishing", "value": 3, "isStandard": false },
      { "id": "impossible", "label": "Impossible", "value": 5, "isStandard": false }
    ],
    "opposition": "symmetric",
    "scalesWithProgression": true,
    "_comment": "A 3-dice pool at 30% per die clears one success 65.7% of the time — the family's natural anchor. Opposition is symmetric here: court rivals are built on the same chassis as the players, which is why prepBurden sits at 5 rather than 2."
  },

  "chassis": {
    "layers": ["attributes", "skills", "tags", "derived", "resources"],
    "attributes": [
      { "id": "body", "label": "Body", "abbrev": "BOD",
        "range": { "min": 1, "max": 5, "typical": 2 }, "encoding": "dot-rating" },
      { "id": "mind", "label": "Mind", "abbrev": "MND",
        "range": { "min": 1, "max": 5, "typical": 2 }, "encoding": "dot-rating" },
      { "id": "spirit", "label": "Spirit", "abbrev": "SPR",
        "range": { "min": 1, "max": 5, "typical": 2 }, "encoding": "dot-rating" }
    ],
    "skills": {
      "kind": "domains",
      "specialisations": true,
      "domains": [
        { "id": "court", "label": "Court", "attribute": "mind" },
        { "id": "blade", "label": "Blade", "attribute": "body" },
        { "id": "bargain", "label": "Bargain", "attribute": "spirit" },
        { "id": "lore", "label": "Lore", "attribute": "mind" },
        { "id": "endure", "label": "Endure", "attribute": "body" }
      ]
    },
    "archetypes": { "kind": "none" },
    "tags": {
      "enabled": true,
      "costModel": "paired-drawback",
      "categories": ["bargain-made", "reputation", "affliction"]
    },
    "identityAxes": [
      { "id": "house", "label": "House", "mechanical": true,
        "options": [
          { "id": "ash", "label": "House Ash",
            "mods": [{ "op": "append", "path": "chassis.tags.categories", "value": "ash-rite" }] },
          { "id": "gilt", "label": "House Gilt",
            "mods": [{ "op": "append", "path": "chassis.tags.categories", "value": "gilt-rite" }] }
        ] }
    ],
    "derived": [
      { "id": "resolve", "label": "Resolve", "rounding": "floor",
        "formula": { "t": "bin", "op": "+",
          "a": { "t": "ref", "path": "attr.spirit.value" },
          "b": { "t": "ref", "path": "attr.mind.value" } } },
      { "id": "threshold", "label": "Injury Threshold", "rounding": "floor",
        "formula": { "t": "bin", "op": "+",
          "a": { "t": "num", "v": 3 },
          "b": { "t": "ref", "path": "attr.body.value" } } },
      {
        "id": "success-threshold",
        "label": "Success threshold",
        "rounding": "floor",
        "clamp": { "min": 6, "max": 8 },
        "formula": {
          "t": "bin", "op": "-",
          "a": { "t": "num", "v": 8 },
          "b": { "t": "call", "fn": "floor", "args": [
            { "t": "bin", "op": "/", "a": { "t": "ref", "path": "harm.corruption.filled" }, "b": { "t": "num", "v": 3 } } ] }
        },
        "_comment": "THE CENTREPIECE MUTATION. Dice succeed on 8+ normally, but every 3 points of Corruption lowers the threshold by 1, to a floor of 6. Corruption makes you better at everything and is otherwise ruinous. Expressed entirely as a clamped formula tree over a harm track — no scripting needed, and because it is a tree the probability engine can still compute exact curves at each corruption level."
      }
    ],
    "resources": [
      { "id": "leverage", "label": "Leverage", "startsAt": "empty", "refresh": "session",
        "max": { "t": "num", "v": 4 } }
    ]
  },

  "creation": {
    "method": "point-buy",
    "budget": { "t": "num", "v": 20 },
    "startingTier": 1,
    "startingKit": ["a court appointment", "one bargain already made"],
    "tableTimeBudgetMin": 45,
    "groupSteps": ["bonds", "group-resources"]
  },

  "progression": {
    "currency": "xp",
    "earnTriggers": ["achieve-goals", "act-on-beliefs", "spend-downtime"],
    "purchase": "a-la-carte",
    "curve": "diminishing",
    "tiers": [],
    "ceiling": 5,
    "horizontalRatio": 0.6,
    "endgame": "ascension"
  },

  "harm": {
    "tracks": [
      {
        "id": "injury",
        "label": "Injury",
        "kind": { "model": "wound-boxes", "boxes": 7, "penaltyPerBox": { "t": "num", "v": -1 } },
        "damage": "margin-derived",
        "mitigation": "threshold",
        "deathSpiral": true,
        "defeat": "death",
        "recovery": { "rate": "downtime", "requiresRoll": true }
      },
      {
        "id": "corruption",
        "label": "Corruption",
        "kind": { "model": "wound-boxes", "boxes": 12, "penaltyPerBox": { "t": "num", "v": 0 } },
        "damage": "fixed",
        "mitigation": "none",
        "deathSpiral": false,
        "defeat": "retirement",
        "recovery": { "rate": "never", "requiresRoll": false },
        "_comment": "Filling all 12 retires the character to the court of whatever they bargained with. Note penaltyPerBox is 0 — corruption's cost is entirely in the custom rules below and in what it does to social rolls, not in a flat dice penalty."
      }
    ]
  },

  "economy": {
    "metaCurrencies": [
      { "id": "leverage", "label": "Leverage", "holder": "player",
        "earnTriggers": ["honouring a bargain", "a Triumph"], "cap": 4, "refresh": "session" },
      { "id": "debt", "label": "Debt", "holder": "gm",
        "earnTriggers": ["a Backlash", "spending Leverage"], "cap": 6, "refresh": "never",
        "_comment": "Two-sided economy: every point of Leverage a player spends banks a point of Debt for the GM. The pressure device and the player currency are the same mechanism seen from both sides." }
    ],
    "abilityResources": ["points", "recharge-on-roll"],
    "wealth": "abstract-level",
    "encumbrance": "none",
    "downtime": { "model": "project-clocks", "actionsPerInterval": 2 }
  },

  "conflict": {
    "initiative": "popcorn",
    "actionEconomy": "one-per-turn",
    "space": "range-bands",
    "roundScale": "a handful of heartbeats",
    "engagement": "opposed",
    "frames": [
      { "id": "social", "label": "Court intrigue", "mode": "own-procedure" },
      { "id": "investigation", "label": "Inquiry", "mode": "reuses-core" },
      { "id": "chase", "label": "Pursuit", "mode": "off" }
    ],
    "scaleConflicts": ["domains"]
  },

  "subsystems": [
    { "moduleId": "factions", "config": { "clocks": true, "tiers": 4, "reputation": true } },
    { "moduleId": "social", "config": { "influenceAsConflict": true, "dispositionTrack": true } },
    { "moduleId": "sanity", "config": { "trackId": "corruption", "breakdownAtFull": "retirement" } }
  ],

  "customRules": [
    {
      "id": "the-bargain-answers",
      "label": "The Bargain Answers",
      "trigger": { "on": "before-roll",
        "filter": { "t": "bin", "op": "==", "a": { "t": "ref", "path": "roll.domain" }, "b": { "t": "num", "v": 2 } } },
      "condition": { "t": "bin", "op": ">=", "a": { "t": "ref", "path": "harm.corruption.filled" }, "b": { "t": "num", "v": 6 } },
      "effects": [
        { "kind": "add-die", "sides": 10, "count": { "t": "num", "v": 2 } },
        { "kind": "adjust-harm", "trackId": "corruption", "amount": { "t": "num", "v": 1 } },
        { "kind": "narrate", "text": "Something answers before the sorcerer finishes asking. Describe what the room notices." }
      ],
      "priority": 10
    },
    {
      "id": "gilded-tongue",
      "label": "Gilded Tongue",
      "trigger": { "on": "on-band" },
      "condition": {
        "t": "bin", "op": "&&",
        "a": { "t": "bin", "op": "==", "a": { "t": "ref", "path": "band.valence" }, "b": { "t": "num", "v": 3 } },
        "b": { "t": "bin", "op": ">=", "a": { "t": "ref", "path": "harm.corruption.filled" }, "b": { "t": "num", "v": 9 } }
      },
      "effects": [
        { "kind": "modify-roll", "amount": { "t": "num", "v": -2 } },
        { "kind": "narrate", "text": "They can hear it in the voice now. Social successes land colder than intended." }
      ],
      "priority": 5,
      "_comment": "The counterweight to the-bargain-answers. High corruption buys dice on bargain rolls and costs effectiveness everywhere social. Two rules, opposite signs, same track — this is the shape most 'power at a price' subsystems take, and it is fully expressible without scripting."
    }
  ],

  "gm": {
    "adversaryTemplate": [
      { "id": "pool", "label": "Pool",
        "formula": { "t": "bin", "op": "+", "a": { "t": "num", "v": 3 }, "b": { "t": "ref", "path": "adversary.tier" } } },
      { "id": "threshold", "label": "Injury Threshold",
        "formula": { "t": "bin", "op": "+", "a": { "t": "num", "v": 3 }, "b": { "t": "ref", "path": "adversary.tier" } } },
      { "id": "boxes", "label": "Wound boxes", "formula": { "t": "num", "v": 7 } }
    ],
    "encounterBudget": "guideline",
    "pressureDevices": ["clocks", "doom-pool"],
    "randomTables": false,
    "gmRolls": "everything",
    "gmMoves": []
  },

  "mods": []
}
