{
  "_comment": "WORKED EXAMPLE 1 of 3 — a modest fork. Takes the d20 class-and-level lineage and makes two deliberate mutations: adds a partial-success band (near misses cost something rather than doing nothing), and caps the power ceiling at tier 10 with a flatter curve so the difficulty ladder does not have to chase progression. Everything else is inherited.",

  "schemaVersion": 1,
  "lineage": ["scratch", "d20-family", "d20-bounded"],

  "meta": {
    "id": "ironbound",
    "name": "Ironbound",
    "pitch": "Armoured survivors clear the ruins of a drowned empire. Familiar to anyone who has played an adventure game, but every near miss costs you something.",
    "toneTags": ["gritty", "heroic"],
    "playPattern": "gm-party",
    "partySize": { "min": 3, "max": 5 },
    "sessionShape": "campaign",
    "dials": {
      "crunch": 6,
      "lethality": 6,
      "swinginess": 7,
      "playerAuthority": 4,
      "prepBurden": 6,
      "powerCeiling": 5
    }
  },

  "resolution": {
    "dice": { "kind": "single", "count": { "t": "num", "v": 1 }, "sides": 20, "companionDice": [] },
    "direction": "high",
    "comparison": {
      "mode": "meet-or-beat",
      "target": { "t": "ref", "path": "difficulty.value" }
    },
    "bands": [
      {
        "id": "fumble",
        "label": "Fumble",
        "when": { "t": "bin", "op": "==", "a": { "t": "ref", "path": "raw" }, "b": { "t": "num", "v": 1 } },
        "valence": "critical-failure",
        "guidance": "The attempt fails and the situation gets actively worse. Introduce a new problem.",
        "effects": []
      },
      {
        "id": "failure",
        "label": "Failure",
        "when": {
          "t": "bin", "op": "&&",
          "a": { "t": "bin", "op": "!=", "a": { "t": "ref", "path": "raw" }, "b": { "t": "num", "v": 1 } },
          "b": { "t": "bin", "op": "<", "a": { "t": "ref", "path": "margin" }, "b": { "t": "num", "v": -2 } }
        },
        "valence": "failure",
        "guidance": "It does not work. Say what closes off.",
        "effects": []
      },
      {
        "id": "partial",
        "label": "Bought at a price",
        "when": {
          "t": "bin", "op": "&&",
          "a": { "t": "bin", "op": ">=", "a": { "t": "ref", "path": "margin" }, "b": { "t": "num", "v": -2 } },
          "b": { "t": "bin", "op": "<", "a": { "t": "ref", "path": "margin" }, "b": { "t": "num", "v": 0 } }
        },
        "valence": "mixed",
        "guidance": "MUTATION: missing by 1 or 2 succeeds anyway, but the character takes 1 Strain or the GM introduces a complication. This is the band the base lineage does not have.",
        "effects": [
          { "kind": "adjust-harm", "trackId": "strain", "amount": { "t": "num", "v": 1 } }
        ]
      },
      {
        "id": "success",
        "label": "Success",
        "when": {
          "t": "bin", "op": "&&",
          "a": { "t": "bin", "op": ">=", "a": { "t": "ref", "path": "margin" }, "b": { "t": "num", "v": 0 } },
          "b": { "t": "bin", "op": "!=", "a": { "t": "ref", "path": "raw" }, "b": { "t": "num", "v": 20 } }
        },
        "valence": "success",
        "guidance": "It works as intended.",
        "effects": []
      },
      {
        "id": "critical",
        "label": "Critical",
        "when": { "t": "bin", "op": "==", "a": { "t": "ref", "path": "raw" }, "b": { "t": "num", "v": 20 } },
        "valence": "critical-success",
        "guidance": "It works, and the character gains position: advantage on the next related roll.",
        "effects": []
      }
    ],
    "contributions": [
      { "source": "attribute", "apply": "modifier-table" },
      { "source": "skill", "apply": "raw" },
      { "source": "equipment", "apply": "raw" },
      { "source": "situational", "apply": "flat-bonus" }
