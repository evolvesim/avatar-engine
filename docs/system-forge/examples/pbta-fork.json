{
  "_comment": "WORKED EXAMPLE 2 of 3 — near-vanilla lineage use. This is what a novice produces: fork the 2d6 move-driven family, answer about a dozen guided questions, accept every other default. Included to show the low end of the flow, and to demonstrate that a system with no skill list, no initiative, no GM rolls and no difficulty ladder still fills the same schema without empty scaffolding.",

  "schemaVersion": 1,
  "lineage": ["scratch", "pbta-family", "pbta-2d6"],

  "meta": {
    "id": "last-shift",
    "name": "The Last Shift",
    "pitch": "Night-shift staff at a hospital that is not entirely a hospital. Everyone is tired, everyone is compromised, and the paperwork still has to be filed.",
    "toneTags": ["bleak", "procedural"],
    "playPattern": "gm-party",
    "partySize": { "min": 3, "max": 4 },
    "sessionShape": "episodic",
    "dials": {
      "crunch": 2,
      "lethality": 4,
      "swinginess": 4,
      "playerAuthority": 7,
      "prepBurden": 2,
      "powerCeiling": 3
    }
  },

  "resolution": {
    "dice": { "kind": "sum", "count": { "t": "num", "v": 2 }, "sides": 6, "companionDice": [] },
    "direction": "high",
    "comparison": { "mode": "ladder" },
    "bands": [
      {
        "id": "miss",
        "label": "Miss",
        "when": { "t": "bin", "op": "<=", "a": { "t": "ref", "path": "total" }, "b": { "t": "num", "v": 6 } },
        "valence": "failure",
        "guidance": "The GM makes a move. Mark experience.",
        "effects": [
          { "kind": "adjust-resource", "resourceId": "experience", "amount": { "t": "num", "v": 1 } }
        ]
      },
      {
        "id": "partial",
        "label": "Yes, but",
        "when": {
          "t": "bin", "op": "&&",
          "a": { "t": "bin", "op": ">=", "a": { "t": "ref", "path": "total" }, "b": { "t": "num", "v": 7 } },
          "b": { "t": "bin", "op": "<=", "a": { "t": "ref", "path": "total" }, "b": { "t": "num", "v": 9 } }
        },
        "valence": "mixed",
        "guidance": "It works, but there is a cost, a complication, or a hard choice. The most common result at the table — write the game around this band.",
        "effects": []
      },
      {
        "id": "hit",
        "label": "Yes",
        "when": { "t": "bin", "op": ">=", "a": { "t": "ref", "path": "total" }, "b": { "t": "num", "v": 10 } },
        "valence": "success",
        "guidance": "It works. Say how, and let the player narrate the detail.",
        "effects": []
      }
    ],
    "contributions": [
      { "source": "attribute", "apply": "raw" },
      { "source": "situational", "apply": "flat-bonus" }
    ],
    "swingModifiers": ["flat-bonus"],
    "interventions": []
  },

  "difficulty": {
    "anchorSuccessRate": 0.7,
    "ladder": [
      { "id": "standard", "label": "Any move", "value": 7, "isStandard": true }
    ],
    "opposition": "asymmetric",
    "scalesWithProgression": false,
    "_comment": "There is no difficulty ladder in this family — the bands are the difficulty. The single ladder entry exists so the validators have an anchor to measure against. anchorSuccessRate 0.7 is partial + hit combined at +1, which the probability engine reports as 27.8 / 44.4 / 27.8."
  },

  "chassis": {
    "layers": ["attributes", "moves", "resources"],
    "attributes": [
      { "id": "steady", "label": "Steady", "abbrev": "STD",
        "range": { "min": -1, "max": 3, "typical": 1 }, "encoding": "raw" },
      { "id": "sharp", "label": "Sharp", "abbrev": "SHP",
        "range": { "min": -1, "max": 3, "typical": 1 }, "encoding": "raw" },
