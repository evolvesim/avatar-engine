  "progression": {
    "currency": "advance-tokens",
    "earnTriggers": ["fail-rolls", "act-on-beliefs"],
    "purchase": "advance-list",
    "curve": "capped",
    "tiers": [],
    "ceiling": 8,
    "horizontalRatio": 0.9,
    "endgame": "retirement",
    "_comment": "horizontalRatio 0.9 — almost all advancement grants new moves rather than raising numbers. This is why scalesWithProgression can be false and bounded-accuracy-drift stays quiet."
  },

  "harm": {
    "tracks": [
      {
        "id": "condition",
