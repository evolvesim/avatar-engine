      },
      {
        "id": "exhaustion",
        "label": "Exhaustion",
        "kind": { "model": "wound-boxes", "boxes": 6, "penaltyPerBox": { "t": "num", "v": 0 } },
        "damage": "fixed",
        "mitigation": "none",
        "deathSpiral": false,
        "defeat": "out-of-action",
        "recovery": { "rate": "never", "requiresRoll": false },
        "_comment": "Fills over the course of a shift and does not empty. Filling it ends the character's night — the closest thing this game has to death."
      }
    ]
  },

